#!name = 60s 读懂世界 (一体化)
#!desc = 每天定时获取 60s 读懂世界早报
#!author = lzwme
#!homepage = https://github.com/lzwme/60s-php
#!icon = https://raw.githubusercontent.com/lzwme/60s-php/main/icon.png
#!system = ios,tvos,macos
#!loon_version = 3.2.1(734)

[Argument]
cronTime = input,"0 8 * * *",tag=推送时间,desc=Cron表达式(分 时 日 月 周)
apiType = select,"60s","bing","history","weibo","zhihu","bili",tag=新闻类型

[Script]
cron {cronTime} script-path=https://raw.githubusercontent.com/miatazz/Loon/refs/heads/main/JS/new%2060s.js, tag=60s早报推送, enable=true, argument={"type":"60s","maxNews":8,"chunkSize":3,"multiNotify":true,"openImage":true}